# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Node
node_modules/

# Build artifacts
*.zip
dist-zip/

# Test output
test-results/
playwright-report/
coverage/
.phpunit.result.cache

# Translations: ship languages/*.pot only.
# translate.wordpress.org handles .po/.mo.
*.po
*.mo
# The theme is not distributed on WordPress.org, so no language pack
# reaches it: its Japanese translation ships with it.
!theme/languages/ja.po
!theme/languages/ja.mo

# Development dependencies
/vendor/
# Composer's working copy; the plugin ships vendor-prefixed/ instead
/plugin/vendor/
