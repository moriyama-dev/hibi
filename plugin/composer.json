{
    "name": "moriyama-dev/hibi-journal",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "minishlink/web-push": "^9"
    },
    "config": {
        "platform": {
            "php": "8.1"
        },
        "optimize-autoloader": true
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "Hibi\\Vendor\\",
            "classmap_prefix": "Hibi_Vendor_",
            "constant_prefix": "HIBI_VENDOR_",
            "packages": [
                "minishlink/web-push"
            ],
            "delete_vendor_packages": true,
            "delete_vendor_files": true
        }
    }
}
