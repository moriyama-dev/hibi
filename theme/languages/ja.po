msgstr "書いていない日に問いかけを表示する"

#: inc/strings.php:201
msgid "Add to the Home Screen"
msgstr "ホーム画面に追加"

#: inc/strings.php:202
msgid "iPhone and iPad: open this site in Safari, tap the Share button, then “Add to Home Screen”."
msgstr "iPhone・iPad：Safari でこのサイトを開き、共有ボタンから「ホーム画面に追加」を選びます。"

#: inc/strings.php:203
msgid "Android: open the browser menu and choose “Install app” or “Add to Home screen”."
msgstr "Android：ブラウザのメニューから「アプリをインストール」または「ホーム画面に追加」を選びます。"

#: inc/strings.php:204
msgid "Install the app"
msgstr "アプリとして追加"

#: inc/strings.php:205
msgid "Your data"
msgstr "データ"

#: inc/strings.php:206
msgid "Download everything (ZIP)"
msgstr "すべて書き出す（ZIP）"

#: inc/strings.php:207
msgid "Every entry as Markdown and JSON, with photos. Keep a copy somewhere safe."
msgstr "すべての日記を Markdown と JSON で、写真と一緒に書き出します。安全な場所に保管してください。"

#: inc/strings.php:208
msgid "Import a Hibi ZIP or JSON file"
msgstr "Hibi の ZIP または JSON を取り込む"

#: inc/strings.php:209
msgid "Days that already have an entry are skipped."
msgstr "すでに日記がある日は取り込みません。"

#. translators: 1: number of entries imported, 2: number skipped.
#: inc/strings.php:211
#, php-format
msgid "Imported %1$d, skipped %2$d."
msgstr "%1$d日分を取り込み、%2$d日分を飛ばしました。"

#: inc/strings.php:212
msgid "The file could not be imported."
msgstr "取り込めませんでした。"

#: inc/strings.php:213
msgid "Log out"
msgstr "ログアウト"

#: inc/strings.php:214
msgid "Some changes have not been sent yet. Log out anyway? They stay on this device and are sent the next time you log in here."
msgstr "まだ送信していない変更があります。ログアウトしますか？変更はこの端末に残り、次にここでログインしたときに送られます。"

#: inc/strings.php:215
msgid "Saved."
msgstr "保存しました。"

#: inc/strings.php:218
msgid "Clear"
msgstr "晴れ"

#: inc/strings.php:219
msgid "Partly cloudy"
msgstr "晴れ時々くもり"

#: inc/strings.php:220
msgid "Cloudy"
msgstr "くもり"

#: inc/strings.php:221
msgid "Fog"
msgstr "霧"

#: inc/strings.php:222
msgid "Drizzle"
msgstr "霧雨"

#: inc/strings.php:223
msgid "Rain"
msgstr "雨"

#: inc/strings.php:224
msgid "Snow"
msgstr "雪"

#: inc/strings.php:225
msgid "Thunderstorm"
msgstr "雷雨"

#: inc/strings.php:236
msgid "What made you smile today?"
msgstr "今日、思わず笑顔になったことは？"

#: inc/strings.php:237
msgid "What took most of your time today?"
msgstr "今日いちばん時間を使ったことは？"

#: inc/strings.php:238
msgid "Who did you talk to today?"
msgstr "今日、誰と話しましたか？"

#: inc/strings.php:239
msgid "What did you eat today that you want to remember?"
msgstr "今日食べたもので、覚えておきたいものは？"

#: inc/strings.php:240
msgid "What went better than expected?"
msgstr "思ったよりうまくいったことは？"

#: inc/strings.php:241
msgid "What would you do differently if you had today again?"
msgstr "今日をやり直せるなら、何を変えますか？"

#: inc/strings.php:242
msgid "What did you learn today?"
msgstr "今日、新しく知ったことは？"

#: inc/strings.php:243
msgid "What are you looking forward to tomorrow?"
msgstr "明日の楽しみは？"

#: inc/strings.php:244
msgid "What tired you out today?"
msgstr "今日、疲れたことは？"

#: inc/strings.php:245
msgid "What is one small thing you are grateful for?"
msgstr "小さくても、ありがたかったことは？"

#: inc/strings.php:246
msgid "What did you notice on the way somewhere today?"
msgstr "今日、移動中に目に留まったものは？"

#: inc/strings.php:247
msgid "What did the children say or do today?"
msgstr "子どもたちが今日言ったこと、したことは？"

#: inc/strings.php:248
msgid "What was the weather like, and how did it feel?"
msgstr "今日の天気と、そのときの気分は？"

#: inc/strings.php:249
msgid "What did you finish today?"
msgstr "今日やり終えたことは？"

#: inc/strings.php:250
msgid "What is on your mind right now?"
msgstr "いま、頭の中にあることは？"

#: inc/strings.php:251
msgid "What did you read, watch or listen to?"
msgstr "読んだもの、見たもの、聴いたものは？"

#: inc/strings.php:252
msgid "What made you laugh?"
msgstr "笑ったことは？"

#: inc/strings.php:253
msgid "Was there a moment you felt calm today?"
msgstr "今日、ほっとした瞬間はありましたか？"

#: inc/strings.php:254
msgid "What worried you, and how big does it feel now?"
msgstr "気がかりだったことと、いまの気持ちは？"

#: inc/strings.php:255
msgid "What did you do for your body today?"
msgstr "今日、体のためにしたことは？"

#: inc/strings.php:256
msgid "What surprised you today?"
msgstr "今日、驚いたことは？"

#: inc/strings.php:257
msgid "Who helped you, or whom did you help?"
msgstr "誰かに助けられたこと、誰かを助けたことは？"

#: inc/strings.php:258
msgid "What do you want to remember about this week?"
msgstr "今週のことで、覚えておきたいことは？"

#: inc/strings.php:259
msgid "What did you put off, and why?"
msgstr "後回しにしたことと、その理由は？"

#: inc/strings.php:260
msgid "Where were you at three o’clock this afternoon?"
msgstr "今日の午後3時、どこにいましたか？"

#: inc/strings.php:261
msgid "What sound, smell or colour stood out today?"
msgstr "今日、印象に残った音・におい・色は？"

#: inc/strings.php:262
msgid "What would you tell yourself a year from now?"
msgstr "1年後の自分に伝えたいことは？"

#: inc/strings.php:263
msgid "What was the best part of the evening?"
msgstr "今夜いちばん良かったことは？"

#: inc/strings.php:264
msgid "What is something you want to try soon?"
msgstr "近いうちにやってみたいことは？"

#: inc/strings.php:265
msgid "Describe today in three words, then explain one."
msgstr "今日を3つの言葉で表すと？そのうち1つを詳しく。"

#: index.php:22
msgid "Hibi needs JavaScript to run."
msgstr "Hibi を使うには JavaScript が必要です。"

#: index.php:26
msgid "Please activate the Hibi Journal plugin."
msgstr "Hibi Journal プラグインを有効にしてください。"

#: singular.php:21
msgid "Back to the journal"
msgstr "日記に戻る"

#: singular.php:32
msgid "Pages:"
msgstr "ページ："

