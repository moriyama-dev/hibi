msgstr "テスト通知を送りました。"

#: inc/strings.php:168
msgid "There is no device to send to."
msgstr "送れる端末がありません。"

#: inc/strings.php:169
msgid "The test notification could not be sent."
msgstr "テスト通知を送れませんでした。"

#: inc/strings.php:170
msgid "This browser does not support notifications."
msgstr "このブラウザは通知に対応していません。"

#: inc/strings.php:171
msgid "Notifications work only when the site is opened over https."
msgstr "通知は https で開いたときだけ使えます。"

#: inc/strings.php:172
msgid "Notifications are blocked. Allow them in the browser’s site settings."
msgstr "通知がブラウザで拒否されています。ブラウザのサイト設定から許可してください。"

#: inc/strings.php:173
msgid "This device does not receive notifications."
msgstr "この端末には通知が届きません。"

#: inc/strings.php:174
msgid "This device receives notifications."
msgstr "この端末に通知が届きます。"

